{
    "name":"fixinator-gui",
    "openBrowser":false,
    "trayEnable":false,
    "jvm":{
        "heapSize":512,
        "minHeapSize":128
    },
    "web":{
        "host":"127.0.0.1",
        "welcomeFiles":"index.cfm",
        "HTTP":{
            "enable":true,
            "port":8584
        },
        "rewrites":{
            "enable":"true",
            "config":"rewrites.xml"
        },
        "allowedExt":"js,css,png,mjs",
        "mimeTypes": {
            "mjs":"text/javascript"
        }
    }
}
